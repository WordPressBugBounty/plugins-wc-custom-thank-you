#: woocommerce-custom-thankyou.php
#. Plugin Name of the plugin
msgid "Custom Thank You Page for WooCommerce"
msgstr "Tilpasset Takke Side til WooCommerce"

#: woocommerce-custom-thankyou.php
#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/wc-custom-thank-you/"
msgstr "https://wordpress.org/plugins/wc-custom-thank-you/"

#: woocommerce-custom-thankyou.php
#. Description of the plugin
msgid ""
"A WooCommerce extension that allows you to define a custom Thank You (Order "
"Confirmation) page."
msgstr ""
"En WooCommerce udvidelse, der giver dig mulighed for at definere en "
"tilpasset Takke (Ordrebekræftelse) side."

#: woocommerce-custom-thankyou.php
#. Author of the plugin
msgid "Riaan Knoetze"
msgstr "Riaan Knoetze"

#: woocommerce-custom-thankyou.php
#. Author URI of the plugin
msgid "https://profiles.wordpress.org/riaanknoetze/"
msgstr "https://profiles.wordpress.org/riaanknoetze/"

